# Local development and Compose. Generate SETUP_TOKEN yourself before setup.
RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME=openGym
WEB_PORT=8080
EXPOSURE=private
DEVICE_TOKENS=1
INVITE_ONLY=1
FIRST_USER_ADMIN=0
ALLOW_GUEST=1
SETUP_TOKEN=
AUDIT_LOG=1
AUDIT_IP=off
# TRUST_PROXY is enabled only inside Compose's isolated reverse-proxy network.
# Direct server processes keep it disabled unless their trusted proxy replaces headers.
