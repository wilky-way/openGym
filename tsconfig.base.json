{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [
      "bun"
    ],
    "paths": {
      "@opengym/core/*": [
        "./packages/contract/core-api/*"
      ]
    }
  }
}
