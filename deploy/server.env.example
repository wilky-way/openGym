# Operator values only. Keep the real mode-600 env outside every release/static tree.
ORIGIN=https://gym.example
RP_ID=gym.example
RP_NAME=openGym
HOST=127.0.0.1
PORT=8080
BASE_PATH=
EXPOSURE=private
DEVICE_TOKENS=1
FIRST_USER_ADMIN=0
INVITE_ONLY=1
ALLOW_GUEST=0
OFFLOAD_RULE=COPY_EXISTING_0_OR_1
# Do not inherit nginx's trust setting. Until the edge's overwrite behavior is verified,
# use the actual loopback peer for audit/rate limits (a shared client bucket).
TRUST_PROXY=0
# DATA_DIR and STATIC_DIR supplied as absolute command arguments by the operator wrapper.
# Preserve the EXISTING OFFLOAD_RULE, ORIGIN, RP_ID, SESSION_DAYS and signing/VAPID files.
# Replace the required OFFLOAD_RULE placeholder; startup refuses it until copied.
# No SETUP_TOKEN on a populated install. This is not a shell script; parse key=value data.
