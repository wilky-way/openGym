{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openGym ProgrammeDefinition",
  "description": "Structural validity; use programmeConformance for Complete and Ready. Unknown extension fields are retained.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "name": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "unit": {
      "enum": [
        "kg",
        "lb"
      ]
    },
    "end": {
      "anyOf": [
        {
          "enum": [
            "next",
            "repeat",
            "stop"
          ]
        },
        {
          "type": "null"
        }
