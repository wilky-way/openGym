    "tmSeeds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "additionalProperties": {
        "$ref": "#/$defs/tmSeed"
      }
    }
  },
  "required": [
    "id",
    "name",
    "unit",
    "weeks"
