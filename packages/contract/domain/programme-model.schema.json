        {
          "type": "string",
          "maxLength": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "daysPerWeek": {
      "type": "integer",
      "minimum": 1
    },
    "lengthWeeks": {
      "type": "integer",
      "minimum": 1
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 10000,
        "minLength": 1
      },
      "uniqueItems": true
    },
    "licence": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 10000
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "endPlan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "deload",
                "test",
                "repeat",
                "next",
                "stop"
              ]
            },
            "instructions": {
              "type": "string",
              "maxLength": 10000,
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "instructions"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "instructions": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "needsReview": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 10000
      }
    },
    "rulesSupported": {
      "type": "boolean"
    },
    "weeks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/week"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "progressionRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/progressionRule"
      },
      "minItems": 0,
      "maxItems": 100
