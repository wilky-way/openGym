{
  "name": "opengym",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/web build && bun run build:server",
    "build:web": "bun run --cwd packages/web build",
    "build:server": "bun build --compile --minify --sourcemap=none --no-compile-autoload-dotenv --no-compile-autoload-bunfig packages/server/src/cli/serve.ts --outfile dist/opengym-server",
    "start:server": "bun packages/server/src/cli/serve.ts",
    "test:core": "bun run --cwd packages/core test",
    "test:web": "bun run --cwd packages/web test",
    "test:mcp": "bun run --cwd packages/mcp test",
    "test:server": "bun run --cwd packages/server test",
    "backup:create": "bun packages/server/src/cli/backup.ts create",
    "backup:verify": "bun packages/server/src/cli/backup.ts verify",
    "audit:dependencies": "bun audit",
    "test:contract": "bun run --cwd packages/contract test",
    "test:parity": "bun run --cwd packages/parity test",
    "test:foundation": "bun --bun vitest run --config scripts/vitest.config.ts",
    "lint:boundaries": "bun scripts/boundaries.ts",
    "gen:model": "bun scripts/gen-model.ts",
    "gen:core-api": "bun scripts/gen-core-api.ts",
    "gen:mcp-tools": "bun scripts/gen-mcp-tools.ts",
    "legacy:verify": "bun scripts/legacy-verify.ts",
    "parity:assert-count": "bun scripts/assert-count.ts",
    "gate": "bun scripts/public-checks.ts",
    "corpus:record": "bun scripts/record-public-requests.ts"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@types/bun": "1.4.3",
    "fast-check": "4.10.2",
    "json-schema-to-typescript": "15.0.4",
    "saxes": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.11",
    "happy-dom": "21.0.1"
  }
}
